# UBI 9 repositories for hermetic RPM prefetching.
#
# The section names (repo ids) are recorded verbatim by hermeto into the SBOM
# purls of prefetched RPMs, and the enterprise-contract `rpm_repos.ids_known`
# policy only accepts repository ids from Red Hat's known_rpm_repositories
# list, which uses arch-specific names. Therefore the sections below are
# split per architecture instead of using a single $basearch section.

[ubi-9-for-x86_64-baseos-rpms]
name = Red Hat Universal Base Image 9 (RPMs) - BaseOS - x86_64
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/baseos/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1

[ubi-9-for-x86_64-baseos-source-rpms]
name = Red Hat Universal Base Image 9 (Source RPMs) - BaseOS - x86_64
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/baseos/source/SRPMS
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1

[ubi-9-for-x86_64-appstream-rpms]
name = Red Hat Universal Base Image 9 (RPMs) - AppStream - x86_64
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/appstream/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1

[ubi-9-for-x86_64-appstream-source-rpms]
name = Red Hat Universal Base Image 9 (Source RPMs) - AppStream - x86_64
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/appstream/source/SRPMS
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1

[codeready-builder-for-ubi-9-x86_64-rpms]
name = Red Hat Universal Base Image 9 (RPMs) - CodeReady Builder - x86_64
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi9/9/x86_64/codeready-builder/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
